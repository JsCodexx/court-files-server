{
  "name": "court-files-server",
  "version": "1.0.0",
  "private": true,
  "description": "API server for Court Files (Express + Drizzle + Supabase Postgres)",
  "main": "dist/index.js",
  "scripts": {
    "dev": "nodemon --exec tsx src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "db:sync": "node scripts/db-sync-both.mjs",
    "db:sync:local": "drizzle-kit push --force",
    "db:migrate": "node scripts/db-migrate-both.mjs",
    "db:migrate:local": "drizzle-kit migrate",
    "cron:subscriptions": "tsx src/jobs/runSubscriptionCronOnce.ts",
    "dry-run:subscriptions": "tsx testing/dry-run-subscription-grace.ts",
    "test:freemium": "node testing/test-freemium-api.mjs",
    "test:api-dry-run": "node testing/api-dry-run.mjs",
    "test:checkout-flow": "node testing/test-checkout-register-flow.mjs",
    "test:subscriptions": "tsx testing/test-subscription-lifecycle.ts",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.111.0",
    "bcryptjs": "^3.0.2",
    "cors": "^2.8.5",
    "dotenv": "^16.5.0",
    "drizzle-orm": "^0.44.2",
    "express": "^5.1.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.2",
    "node-cron": "^4.6.0",
    "nodemailer": "^9.0.5",
    "postgres": "^3.4.7",
    "zod": "^3.25.67"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.15.32",
    "@types/node-cron": "^3.0.11",
    "@types/nodemailer": "^8.0.1",
    "drizzle-kit": "^0.31.1",
    "nodemon": "^3.1.14",
    "pg": "^8.23.0",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3"
  }
}
