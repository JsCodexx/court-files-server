PORT=5500
JWT_SECRET=change-me-to-a-long-random-secret
JWT_EXPIRES_IN=7d
# Browser page origins allowed to call this API (NOT the API URL).
# Include apex + www, and localhost for local checkout testing.
# Production example:
# CORS_ORIGIN=https://clerkdiary.com,https://www.clerkdiary.com
# FRONTEND_URL must match one entry (used in emails / return links).
CORS_ORIGIN=http://localhost:4400
FRONTEND_URL=http://localhost:4400

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-publishable-key
SUPABASE_SECRET_KEY=your-secret-key

# Gmail SMTP — use an App Password, not your normal Gmail password.
# https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-gmail@gmail.com
SMTP_PASS=your-16-char-app-password
MAIL_FROM=Court Files <your-gmail@gmail.com>
# Optional reply-to / support address shown in email footers
MAIL_SUPPORT=aliwheed@gmail.com
RESET_TOKEN_TTL_MINUTES=15

RESET_TOKEN_TTL_MINUTES=15

# Demo payments (local/staging only). Must stay unset/false in production.
# DEMO_PAYMENTS_ENABLED=false

# Rapid Gateway / RapidPay — live payment provider
# Leave empty for demo mode locally when DEMO_PAYMENTS_ENABLED is allowed.
RAPIDGATEWAY_API_KEY=
RAPIDGATEWAY_MERCHANT_ID=
RAPIDGATEWAY_MERCHANT_NAME=Court Files
# Webhook salt from portal → Developers → Webhooks
RAPIDGATEWAY_WEBHOOK_SECRET=
RAPIDGATEWAY_API_BASE=https://secure.rapid-gateway.com
RAPIDGATEWAY_TOKEN_URL=https://secure.rapid-gateway.com/oauth2/token
RAPIDGATEWAY_PAYMENT_PATH=/rapid/process-transaction
# RAPIDGATEWAY_METHODS=easypaisa,jazzcash,card,raast,wallet
# Register webhook URL in portal:
#   {API_PUBLIC_URL}/api/payments/rapidgateway/webhook
# API_PUBLIC_URL=https://api.clerkdiary.com

# Connect to Postgres via the shared transaction-mode pooler (IPv4)
# Supabase Dashboard → Connect → Transaction pooler → URI (port 6543)
# DATABASE_URL=postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-1-ap-northeast-2.pooler.supabase.com:6543/postgres
# Optional: second DB for npm run db:sync / db:migrate (otherwise reads DATABASE_URL from .env.production)
# DATABASE_URL_PRODUCTION=postgresql://...

# Daily subscription reconciliation (default 02:00 server time). Set false to disable in-process cron.
# SUBSCRIPTION_CRON_SCHEDULE=0 2 * * *
# ENABLE_SUBSCRIPTION_CRON=true
