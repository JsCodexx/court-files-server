# Copy to `.env` on EC2 (`/var/www/court-files-server/.env`) or use locally as `.env.production`.
# Do not commit real secrets. Former PM2 URL values belong here:

NODE_ENV=production
PORT=5500

JWT_SECRET=replace-with-long-random-secret
JWT_EXPIRES_IN=7d

CORS_ORIGIN=https://clerkdiary.com,https://www.clerkdiary.com,https://court-files-admin.vercel.app
FRONTEND_URL=https://clerkdiary.com
API_PUBLIC_URL=https://api.clerkdiary.com

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
DATABASE_URL=postgresql://postgres.[ref]:[password]@aws-0-ap-south-1.pooler.supabase.com:6543/postgres

# SMTP, RapidGateway, etc. — see `.env.example`
